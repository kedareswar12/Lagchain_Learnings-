			"id": "shape:1YI2P0NmAZ_Ur4cqKkFWX",
			"type": "text",
			"props": {
				"color": "black",
				"size": "s",
				"w": 686.5750122070312,
				"font": "serif",
				"textAlign": "start",
				"autoSize": true,
				"scale": 0.424878016874021,
				"richText": {
					"type": "doc",
					"attrs": {
						"dir": "auto"
					},
					"content": [
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "The "
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "HuggingFacePipeline.from_model_id()"
								},
								{
									"type": "text",
									"text": " code creates a LangChain LLM "
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "using the "
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "Qwen/Qwen2.5-1.5B-Instruct"
								},
								{
									"type": "text",
									"text": " model from Hugging Face. "
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "The "
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "model_id"
								},
								{
									"type": "text",
									"text": " specifies which model to load, while "
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "task=\"text-generation\""
								},
								{
									"type": "text",
									"text": " "
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "tells Hugging Face that the model will be used to generate text. "
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "The "
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "pipeline_kwargs"
								},
								{
									"type": "text",
									"text": " contains generation settings,"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": " and "
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "max_new_tokens=100"
								},
								{
									"type": "text",
									"text": " means the model can generate a maximum "
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "of 100 new tokens for each request. When we call "
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "llm.invoke"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "(\"What is Docker?\")"
								},
								{
									"type": "text",
									"text": ", the prompt is converted into tokens,"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": " passed through the Qwen model, and the model generates "
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "the response one token at a time until it finishes or reaches the 100-token limit."
								}
							]
						}
					]
				}
			},
